{
  "name": "@agentic-workflow-kit/community-files",
  "version": "0.0.0",
  "description": "Organization profile, community health files, and repository standards for agentic-workflow-kit.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "warn"
    }
  },
  "scripts": {
    "format": "prettier --write \"**/*.{md,yml,yaml,json}\"",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,json}\"",
    "lint": "pnpm format:check",
    "check": "pnpm lint"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
